# Copy to .env (never commit it). Only the key for the provider you use with `npm run paint` is needed.
GEMINI_API_KEY=
OPENAI_API_KEY=
REPLICATE_API_TOKEN=

# Optional, build time: where the deployed app loads tiles/ from (must end with "/"),
# e.g. a public R2 bucket: https://tiles.example.com/dubai/   (default: same origin as the app)
VITE_TILES_BASE=
