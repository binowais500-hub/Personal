DATABASE_URL="file:./dev.db"
# Auto-generated on first `npm run dev` / `npm run build` if missing — do not share this value.
SESSION_SECRET=

# Optional. Powers AI insights, the monthly review, "Ask my finances", and
# AI-suggested categories. Leave blank and the app works normally without
# them — only locally-computed aggregates (category totals, trends, merchant
# names and counts) are ever sent, never raw transactions or account numbers.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
